{
  "name": "@omnilp/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:migrate": "tsx src/migrate.ts",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "telegram:setup": "tsx src/telegram-setup.ts",
    "test": "vitest run src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/rate-limit": "11.2.0",
    "@omnilp/shared": "workspace:*",
    "@ton/ton": "16.1.0",
    "fastify": "5.12.0",
    "pg": "8.23.0",
    "tweetnacl": "1.0.3",
    "viem": "2.38.6",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@types/pg": "8.20.0",
    "tsx": "4.21.0"
  }
}
